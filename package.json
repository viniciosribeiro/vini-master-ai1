{
  "name": "vini-master-ai1",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:voice": "node --test tests/native-voice-contract.test.mjs",
    "build:voice": "esbuild src/vini-native-voice-client.js --bundle --format=iife --platform=browser --target=es2022 --outfile=public/vini-native-voice-client.js",
    "build:preview": "npm run build:voice"
  },
  "devDependencies": {
    "wrangler": "4.156.0",
    "esbuild": "0.28.2"
  },
  "cloudflare": {
    "bindings": {
      "MASTER_TOKEN": {
        "description": "Obrigatório: crie uma chave privada aleatória de 40 ou mais caracteres. Não publique nem compartilhe esta chave."
      },
      "NVIDIA_API_KEY": {
        "description": "Opcional. Chave gratuita NVIDIA NIM. Sem ela, o aplicativo usa Cloudflare Workers AI."
      }
    }
  },
  "dependencies": {
    "agents": "0.32.0"
  }
}
